# 预发布环境专用凭据（**不要提交**，本机 600）
#
# 用法：放在 140 的 /opt/sub2api-pre/seed.local.env，`reset-pre.sh --with-seed` 会读取并写进
# sub2api_pre 的 settings 表。仓库里只有 seed.local.env.example（模板，值为空）。
#
# 为什么单独一份：这些是**发信凭据 + 管理 API 凭据**，属于秘密，不能进 git；
# 而 default_balance / 收款页 / 分组 这类业务配置在 seed.sql 里（可进 git）。
#
# 键名与 settings 表的 key 一一对应（大写即 settings key）。

ADMIN_API_KEY=

ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=

SES_SECRET_ID=
SES_SECRET_KEY=
